{
  "expo": {
    "name": "Voice Killer",
    "slug": "voicekiller",
    "version": "1.0.0",
    "orientation": "portrait",
    "platforms": [
      "ios",
      "android"
    ],
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.voicekiller",
      "usesAppleSignIn": true,
      "entitlements": {
        "com.apple.developer.applesignin": [
          "Default"
        ]
      },
      "icon": {
        "light": "./src/assets/app/icon.png",
        "dark": "./src/assets/app/icon-dark.png"
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.voicekiller",
      "versionCode": 6,
      "blockedPermissions": [
        "android.permission.CAMERA"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/app/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "plugins": [
      "expo-localization",
      "expo-font",
      "expo-asset",
      "expo-secure-store",
      [
        "expo-audio",
        {
          "microphonePermission": "Voice Killer uses the microphone to record a sample of your voice for cloning."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Voice Killer uses your photos to set your profile picture and select videos for audio tools.",
          "cameraPermission": "Voice Killer does not access your camera. Profile photos and videos are selected from your photo library.",
          "microphonePermission": "Voice Killer uses the microphone to record a sample of your voice for cloning."
        }
      ],
      "expo-router",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/app/splash-logo.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#FFF9F6"
        }
      ],
      "expo-sharing",
      "./plugins/withAndroidBuildProperties",
      "./plugins/withReleaseSigning",
      "./plugins/withAudioConversion",
      "./plugins/withIconAppearance",
      "expo-video"
    ],
    "scheme": "voicekiller",
    "userInterfaceStyle": "light",
    "icon": "./src/assets/app/icon.png",
    "backgroundColor": "#FFF9F6",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "144fae10-0b12-4cc3-8c0b-c7bddfac38d3"
      }
    }
  }
}
